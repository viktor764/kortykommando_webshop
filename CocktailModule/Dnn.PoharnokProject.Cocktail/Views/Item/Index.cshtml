﻿@inherits DotNetNuke.Web.Mvc.Framework.DnnWebViewPage<List<PoharnokProject.Dnn.Dnn.PoharnokProject.Cocktail.Models.IngredientCategoryViewModel>>

@{
    // Lekérjük a modul egyedi ID-ját, amivel minden html elemet és JS funkciót egyediesítünk
    var modId = Dnn.ModuleContext.ModuleId.ToString();
}

<style>
    .cocktail-builder {
        width: 100%;
        margin: 20px auto;
        min-height: 50vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        background: #000000;
        color: #ffffff;
        padding: 20px;
        box-sizing: border-box;
    }

    .ingredients-row {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        flex-wrap: nowrap;
        gap: 20px; /* Kicsit nagyobb távolság, hogy a nagyobb képek ne érjenek össze */
        margin-bottom: 20px;
        overflow-x: auto;
        padding-bottom: 5px;
    }

    .ingredient-selector {
        display: flex;
        align-items: center;
        flex: 1 1 0;
        min-width: 220px; /* Szélesebb minimum méret */
        max-width: 350px; /* 250-ről 350px-re növelve, hogy a képek tudjanak nőni */
    }

    .bottle-display {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .image-wrapper {
        position: relative;
        height: 350px; /* 280px-ről 350px-re növelve a gigantikus képekért */
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: flex-end;
    }

    .bottle-img {
        max-height: 100%;
        max-width: 100%; /* Engedjük, hogy teljesen kitöltse a dobozt széltében is */
        z-index: 5;
        object-fit: contain;
        margin-bottom: 8px;
    }

    .bottle-shadow {
        position: absolute;
        bottom: 0px;
        width: 140px; /* Még szélesebb árnyék a hatalmas képekhez */
        height: 25px;
        background: radial-gradient(ellipse at center, rgba(150,50,150,0.3) 0%, rgba(150,0,150,0) 70%);
        z-index: 1;
    }

    .prod-info {
        text-align: center;
        margin-top: 5px;
        width: 100%;
    }

    .prod-name {
        font-size: 1.1em; /* Picit nagyobb betű a nagyobb képhez */
        font-weight: 600;
        color: #ffffff;
        margin-bottom: 4px;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        height: 65px;
        line-height: 1.3;
        overflow: hidden;
    }

    .prod-price {
        font-size: 1.05em; /* Picit nagyobb árcédula */
        font-weight: bold;
        color: #dddddd;
        display: block;
    }

    .nav-arrow {
        background: none;
        border: none;
        font-size: 3em; /* Még nagyobb, határozottabb nyilak */
        color: #ffffff;
        cursor: pointer;
        padding: 0 5px;
        transition: transform 0.2s;
        user-select: none;
    }

        .nav-arrow:hover {
            transform: scale(1.15);
            color: #cccccc;
        }

    .footer-section {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .total-text {
        font-size: 1.5em;
        font-weight: 500;
        margin-bottom: 15px;
        color: #ffffff;
    }

    .add-to-cart-btn {
        background: #333333;
        color: #ffffff;
        border: 1px solid #555555;
        padding: 14px 40px;
        font-size: 1.15em;
        border-radius: 6px;
        cursor: pointer;
        transition: 0.3s;
    }

        .add-to-cart-btn:hover {
            background: #555555;
        }

        .add-to-cart-btn:disabled {
            background: #222222;
            color: #888888;
            border-color: #333333;
            cursor: not-allowed;
        }
</style>

<div class="cocktail-builder" id="cocktail-module-@modId">
    @if (Model != null && Model.Any())
    {
        <div class="ingredients-row">
            @for (int i = 0; i < Model.Count; i++)
            {
                var category = Model[i];
                <div class="ingredient-selector">
                    @* Az onclick eseményt a specifikus, modulosított JavaScript függvényre kötjük *@
                    <button type="button" class="nav-arrow" onclick="window['slide_@(modId)'](@i, -1)">❮</button>

                    <div class="bottle-display">
                        @for (int p = 0; p < category.Products.Count; p++)
                        {
                            var prod = category.Products[p];
                            <div class="product-card card-row-@i"
                                 data-price="@prod.SitePrice.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                 data-bvin="@prod.Bvin"
                                 style="@(p == 0 ? "display:flex;" : "display:none;") flex-direction:column; align-items:center; width:100%;">

                                <div class="image-wrapper">
                                    <img src="/Portals/0/Hotcakes/Data/products/@(prod.Bvin)/medium/@(prod.ImageFileMedium)"
                                         alt="@prod.ProductName"
                                         class="bottle-img"
                                         onerror="this.onerror=null; this.src='/Portals/0/no-image.png';" />
                                    <div class="bottle-shadow"></div>
                                </div>

                                <div class="prod-info">
                                    <span class="prod-name">@prod.ProductName</span>
                                    <span class="prod-price">@prod.SitePrice.ToString("N0") Ft</span>
                                </div>
                            </div>
                        }
                    </div>

                    <button type="button" class="nav-arrow" onclick="window['slide_@(modId)'](@i, 1)">❯</button>
                </div>
            }
        </div>

        <div class="footer-section">
            <div class="total-text">
                @* Az ID helyett classt használunk, hogy a querySelectorAll majd csak ezen a modulon belül keresse *@
                Csomag értéke: <span class="total-display">0 Ft</span>
            </div>
            <button type="button" class="add-to-cart-btn btnAddToCart" onclick="window['addToCart_@(modId)']()">Csomag a kosárba</button>
        </div>
    }
    else
    {
        <div style="text-align:center; padding: 20px;">
            A modul beállításaiban válasszon ki legalább egy kategóriát!
        </div>
    }
</div>

<script>
    (function () {
        const modId = '@modId';
        const container = document.getElementById('cocktail-module-' + modId);

        let currentPositions = [@string.Join(",", Model.Select(m => "0"))];
        let maxCounts = [@string.Join(",", Model.Select(m => m.Products.Count))];

        window['slide_' + modId] = function (catIndex, direction) {
            const cards = container.querySelectorAll('.card-row-' + catIndex);

            if (cards.length > 0) {
                cards[currentPositions[catIndex]].style.display = 'none';
                currentPositions[catIndex] =
                    (currentPositions[catIndex] + direction + maxCounts[catIndex]) % maxCounts[catIndex];
                cards[currentPositions[catIndex]].style.display = 'flex';
                calculateTotal();
            }
        };

        function calculateTotal() {
            let total = 0;

            container.querySelectorAll('.product-card').forEach(card => {
                if (window.getComputedStyle(card).display !== 'none') {
                    total += parseFloat(card.getAttribute('data-price')) || 0;
                }
            });

            const displayEl = container.querySelector('.total-display');
            if (displayEl) {
                displayEl.innerText = Math.round(total).toLocaleString('hu-HU') + " Ft";
            }
        }

        window['addToCart_' + modId] = function () {
            const selectedIds = [];

            container.querySelectorAll('.product-card').forEach(card => {
                if (window.getComputedStyle(card).display !== 'none') {
                    selectedIds.push(card.getAttribute('data-bvin'));
                }
            });

            if (selectedIds.length === 0) {
                alert("Nincs kiválasztott termék.");
                return;
            }

            const btn = container.querySelector('.btnAddToCart');
            btn.disabled = true;
            btn.innerText = "Hozzáadás...";

            $.ajax({
                type: "POST",
                url: '@Url.Action("AddToCart", "Item")',
                traditional: true,
                data: { productIds: selectedIds },
                dataType: "json",

                success: function (response) {
                    if (response && response.success) {
                        window.location.href = '/HotcakesStore/Cart';
                    } else {
                        alert("Hiba: " + (response && response.message ? response.message : "Ismeretlen hiba."));
                        btn.disabled = false;
                        btn.innerText = "Csomag a kosárba";
                    }
                },

                error: function (xhr, textStatus, errorThrown) {
                    console.log("AJAX status:", xhr.status);
                    console.log("AJAX textStatus:", textStatus);
                    console.log("AJAX errorThrown:", errorThrown);
                    console.log("AJAX responseText:", xhr.responseText);

                    /*
                       DNN néha 200-as státusszal is error ágba dobhat,
                       ha a JSON után HTML is visszakerül a válaszba.
                       Ha a kosárba rakás valójában sikerült, akkor itt is tovább lehet menni.
                    */
                    if (xhr.status === 200 && xhr.responseText && xhr.responseText.indexOf('"success":true') !== -1) {
                        window.location.href = '/HotcakesStore/Cart';
                        return;
                    }

                    alert("Sajnos hiba történt a kosárba helyezéskor. Kérjük, próbálja újra!");
                    btn.disabled = false;
                    btn.innerText = "Csomag a kosárba";
                }
            });
        };

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", calculateTotal);
        } else {
            calculateTotal();
        }
    })();
</script>